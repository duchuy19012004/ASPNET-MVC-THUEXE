@model bike.Models.BaoCaoThietHai
@{
    ViewData["Title"] = $"Chỉnh sửa báo cáo thiệt hại #{Model.MaBaoCao}";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}
@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <div>@error.ErrorMessage</div>
        }
    </div>
}

<style>
    .edit-container {
        max-width: 800px;
        margin: 0 auto;
        padding: 30px 0;
    }

    .edit-header {
        background: linear-gradient(135deg, #ffc107 0%, #fd7e14 100%);
        color: white;
        padding: 30px;
        border-radius: 15px 15px 0 0;
        text-align: center;
    }

    .edit-body {
        background: white;
        padding: 30px;
        border-radius: 0 0 15px 15px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.08);
    }

    .section-title {
        color: #333;
        font-size: 20px;
        font-weight: bold;
        margin-bottom: 20px;
        padding-bottom: 10px;
        border-bottom: 2px solid #f0f0f0;
    }

    .form-section {
        margin-bottom: 30px;
    }

    .info-display {
        background: #f8f9fa;
        padding: 15px;
        border-radius: 8px;
        margin-bottom: 20px;
        border-left: 3px solid #17a2b8;
    }

    .info-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 8px;
    }

    .info-label {
        color: #666;
        font-weight: 500;
    }

    .info-value {
        color: #333;
        font-weight: 600;
    }

    .money-input {
        font-size: 16px;
        font-weight: bold;
        text-align: right;
    }

    .cost-preview {
        color: #17a2b8 !important;
        font-weight: 500;
        font-size: 13px;
        margin-top: 4px;
        display: block;
    }

    .cost-preview i {
        margin-right: 5px;
    }

    .btn-save {
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        color: white;
        border: none;
        padding: 15px 40px;
        font-size: 18px;
        font-weight: bold;
        width: 100%;
        margin-top: 20px;
    }

    .btn-save:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 20px rgba(40, 167, 69, 0.4);
        color: white;
    }

    .severity-badge {
        padding: 5px 15px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 500;
    }

    .severity-critical {
        background: #721c24;
        color: white;
    }

    .severity-medium {
        background: #fff3cd;
        color: #856404;
    }
</style>

<div class="edit-container">
    <!-- Header -->
    <div class="edit-header">
        <h2><i class="bi bi-pencil-square"></i> Chỉnh sửa báo cáo thiệt hại</h2>
        <p class="mb-0">Báo cáo #@Model.MaBaoCao - @Model.LoaiThietHai</p>
    </div>

    <!-- Body -->
    <div class="edit-body">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="MaBaoCao" />
            <input type="hidden" asp-for="MaChiTiet" />
            <input type="hidden" asp-for="NgayTao" />
            <input type="hidden" asp-for="NgayPhatHien" />

            <!-- Thông tin hiển thị -->
            <div class="section-title">
                <i class="bi bi-info-circle"></i> Thông tin hiển thị
            </div>
            <div class="form-section">
                <div class="info-display">
                    <div class="info-row">
                        <span class="info-label">Hợp đồng:</span>
                        <span class="info-value">
                            @if (Model.ChiTietHopDong?.HopDong?.MaHopDong != null)
                            {
                                @($"HD{Model.ChiTietHopDong.HopDong.MaHopDong.ToString("D6")}")
                            }
                            else
                            {
                                @("N/A")
                            }
                        </span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Khách hàng:</span>
                        <span class="info-value">@(Model.ChiTietHopDong?.HopDong?.HoTenKhach ?? "N/A")</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Xe:</span>
                        <span class="info-value">
                            @if (!string.IsNullOrEmpty(Model.ChiTietHopDong?.Xe?.TenXe) && !string.IsNullOrEmpty(Model.ChiTietHopDong?.Xe?.BienSoXe))
                            {
                                @($"{Model.ChiTietHopDong.Xe.TenXe} - {Model.ChiTietHopDong.Xe.BienSoXe}")
                            }
                            else
                            {
                                @("N/A")
                            }
                        </span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Ngày phát hiện:</span>
                        <span class="info-value">@Model.NgayPhatHien.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                </div>
            </div>

            <!-- Thông tin thiệt hại -->
            <div class="section-title">
                <i class="bi bi-exclamation-triangle"></i> Thông tin thiệt hại
            </div>
            <div class="form-section">
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="LoaiThietHai" class="form-label">Loại thiệt hại <span class="text-danger">*</span></label>
                            <select asp-for="LoaiThietHai" class="form-select" id="LoaiThietHai" onchange="updateSeverity()">
                                <option value="Hư hỏng nhẹ">Hư hỏng nhẹ</option>
                                <option value="Hư hỏng nặng">Hư hỏng nặng</option>
                                <option value="Mất">Mất</option>
                                <option value="Tai nạn">Tai nạn</option>
                            </select>
                            <span asp-validation-for="LoaiThietHai" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label">Mức độ nghiêm trọng</label>
                            <div>
                                <span class="severity-badge @(Model.LaThietHaiNang ? "severity-critical" : "severity-medium")" id="severityBadge">
                                    @(Model.LaThietHaiNang ? "Nghiêm trọng" : "Nhẹ")
                                </span>
                            </div>
                            <input type="hidden" asp-for="LaThietHaiNang" id="LaThietHaiNang" value="@Model.LaThietHaiNang" />
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="ViTriThietHai" class="form-label">Vị trí thiệt hại</label>
                    <input asp-for="ViTriThietHai" class="form-control" placeholder="VD: Gương chiếu hậu, bánh xe, động cơ..." />
                    <span asp-validation-for="ViTriThietHai" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="MoTaChiTiet" class="form-label">Mô tả chi tiết</label>
                    <textarea asp-for="MoTaChiTiet" class="form-control" rows="4" 
                              placeholder="Mô tả chi tiết về thiệt hại, nguyên nhân, mức độ hư hỏng..."></textarea>
                    <span asp-validation-for="MoTaChiTiet" class="text-danger"></span>
                </div>
            </div>

            <!-- Chi phí -->
            <div class="section-title">
                <i class="bi bi-cash-stack"></i> Chi phí
            </div>
            <div class="form-section">
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="ChiPhiSuaChuaUocTinh" class="form-label">Chi phí sửa chữa ước tính</label>
                            <input asp-for="ChiPhiSuaChuaUocTinh" type="number" class="form-control money-input" min="0" step="any" id="ChiPhiSuaChuaUocTinh" oninput="formatCostDisplay(this, 'uocTinhPreview')" />
                            <small class="cost-preview" id="uocTinhPreview"></small>
                            <span asp-validation-for="ChiPhiSuaChuaUocTinh" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="ChiPhiSuaChuaThucTe" class="form-label">Chi phí sửa chữa thực tế</label>
                            <input asp-for="ChiPhiSuaChuaThucTe" type="number" class="form-control money-input" min="0" step="any" id="ChiPhiSuaChuaThucTe" oninput="formatCostDisplay(this, 'thucTePreview')" />
                            <small class="cost-preview" id="thucTePreview"></small>
                            <span asp-validation-for="ChiPhiSuaChuaThucTe" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="GiaTriXeTruocKhiHong" class="form-label">Giá trị xe trước khi hỏng</label>
                            <input asp-for="GiaTriXeTruocKhiHong" type="number" class="form-control money-input" min="0" step="any" id="GiaTriXeTruocKhiHong" oninput="formatCostDisplay(this, 'truocHongPreview')" />
                            <small class="cost-preview" id="truocHongPreview"></small>
                            <span asp-validation-for="GiaTriXeTruocKhiHong" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="GiaTriXeSauKhiHong" class="form-label">Giá trị xe sau khi hỏng</label>
                            <input asp-for="GiaTriXeSauKhiHong" type="number" class="form-control money-input" min="0" step="any" id="GiaTriXeSauKhiHong" oninput="formatCostDisplay(this, 'sauHongPreview')" />
                            <small class="cost-preview" id="sauHongPreview"></small>
                            <span asp-validation-for="GiaTriXeSauKhiHong" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Thông tin thanh toán -->
            <div class="section-title">
                <i class="bi bi-cash-coin"></i> Thông tin thanh toán
            </div>
            <div class="form-section">
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="PhiDenBuKhachHang" class="form-label">Phí đền bù khách hàng</label>
                            <input asp-for="PhiDenBuKhachHang" type="number" class="form-control money-input" min="0" step="any" id="PhiDenBuKhachHang" oninput="formatCostDisplay(this, 'denBuPreview')" />
                            <small class="cost-preview" id="denBuPreview"></small>
                            <span asp-validation-for="PhiDenBuKhachHang" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="SoTienDaThanhToan" class="form-label">Số tiền đã thanh toán</label>
                            <input asp-for="SoTienDaThanhToan" type="number" class="form-control money-input" min="0" step="any" id="SoTienDaThanhToan" oninput="formatCostDisplay(this, 'daThanhToanPreview')" />
                            <small class="cost-preview" id="daThanhToanPreview"></small>
                            <span asp-validation-for="SoTienDaThanhToan" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="TrangThaiThanhToan" class="form-label">Trạng thái thanh toán</label>
                    <select asp-for="TrangThaiThanhToan" class="form-select" id="TrangThaiThanhToan">
                        <option value="Chưa thanh toán">Chưa thanh toán</option>
                        <option value="Đã thanh toán một phần">Đã thanh toán một phần</option>
                        <option value="Đã thanh toán đủ">Đã thanh toán đủ</option>
                    </select>
                    <span asp-validation-for="TrangThaiThanhToan" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="GhiChuThanhToan" class="form-label">Ghi chú thanh toán</label>
                    <textarea asp-for="GhiChuThanhToan" class="form-control" rows="3" 
                              placeholder="Ghi chú về quá trình thanh toán..."></textarea>
                    <span asp-validation-for="GhiChuThanhToan" class="text-danger"></span>
                </div>
            </div>

            <!-- Buttons -->
            <button type="submit" class="btn btn-save">
                <i class="bi bi-check-circle"></i> Lưu thay đổi
            </button>

            <a asp-action="Index" class="btn btn-secondary mt-3 w-100">
                <i class="bi bi-arrow-left"></i> Quay lại
            </a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    
    <script>
        // Format hiển thị chi phí
        function formatCostDisplay(input, previewId) {
            if (!input) return;
            const value = parseInt(input.value) || 0;
            const preview = document.getElementById(previewId);
            if (!preview) return;
            if (value > 0) {
                preview.innerHTML = '<i class="bi bi-eye"></i> Hiển thị: ' + value.toLocaleString('vi-VN') + 'đ';
            } else {
                preview.innerHTML = '';
            }
        }

        // Cập nhật mức độ nghiêm trọng
        function updateSeverity() {
            const loaiThietHaiInput = document.getElementById('LoaiThietHai');
            const severityBadge = document.getElementById('severityBadge');
            const laThietHaiNangInput = document.getElementById('LaThietHaiNang');
            if (!loaiThietHaiInput || !severityBadge || !laThietHaiNangInput) return;

            const loaiThietHai = loaiThietHaiInput.value;
            let isNghiemTrong = false;

            switch(loaiThietHai) {
                case 'Hư hỏng nhẹ':
                    severityBadge.textContent = 'Nhẹ';
                    severityBadge.className = 'severity-badge severity-medium';
                    isNghiemTrong = false;
                    break;
                case 'Hư hỏng nặng':
                case 'Mất':
                case 'Tai nạn':
                    severityBadge.textContent = 'Nghiêm trọng';
                    severityBadge.className = 'severity-badge severity-critical';
                    isNghiemTrong = true;
                    break;
                default:
                    severityBadge.textContent = '';
                    severityBadge.className = 'severity-badge';
                    isNghiemTrong = false;
                    break;
            }

            laThietHaiNangInput.value = isNghiemTrong;
        }

        // Khởi tạo khi load trang
        document.addEventListener("DOMContentLoaded", function() {
            // Khởi tạo format display cho tất cả input
            formatCostDisplay(document.getElementById('ChiPhiSuaChuaUocTinh'), 'uocTinhPreview');
            formatCostDisplay(document.getElementById('ChiPhiSuaChuaThucTe'), 'thucTePreview');
            formatCostDisplay(document.getElementById('GiaTriXeTruocKhiHong'), 'truocHongPreview');
            formatCostDisplay(document.getElementById('GiaTriXeSauKhiHong'), 'sauHongPreview');
            formatCostDisplay(document.getElementById('PhiDenBuKhachHang'), 'denBuPreview');
            formatCostDisplay(document.getElementById('SoTienDaThanhToan'), 'daThanhToanPreview');
            
            // Cập nhật mức độ nghiêm trọng ban đầu
            updateSeverity();
        });

        document.querySelector('form').addEventListener('submit', function() {
            ['ChiPhiSuaChuaUocTinh', 'ChiPhiSuaChuaThucTe', 'GiaTriXeTruocKhiHong', 'GiaTriXeSauKhiHong', 'PhiDenBuKhachHang', 'SoTienDaThanhToan'].forEach(function(id) {
                var el = document.getElementById(id);
                if (el && (el.value === "" || el.value === null)) {
                    el.value = 0;
                }
            });
        });
    </script>
} 