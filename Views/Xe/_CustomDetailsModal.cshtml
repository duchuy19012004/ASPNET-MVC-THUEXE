@model bike.Models.Xe

<div class="custom-modal-overlay" id="customXeDetailsModal">
    <div class="custom-modal">
        <div class="custom-modal-header">
            <h5 class="custom-modal-title">
                <i class="bi bi-info-circle"></i> Chi tiết xe #XE@(Model.MaXe.ToString("D3"))
            </h5>
            <button type="button" class="custom-modal-close" onclick="closeCustomModal()">
                <i class="bi bi-x"></i>
            </button>
        </div>
        <div class="custom-modal-body">
            <div class="row">
                <!-- Hình ảnh xe -->
                <div class="col-md-4">
                    <div class="text-center mb-3">
                        @if (!string.IsNullOrEmpty(Model.HinhAnhHienThi))
                        {
                            <img src="~/images/xe/@Model.HinhAnhHienThi" class="img-fluid rounded" style="max-height: 200px; object-fit: cover;" alt="@Model.TenXe" />
                        }
                        else
                        {
                            <div class="bg-light rounded d-flex align-items-center justify-content-center" style="height: 200px;">
                                <i class="bi bi-image" style="font-size: 48px; color: #ccc;"></i>
                            </div>
                        }
                    </div>
                    
                    <!-- Trạng thái -->
                    @{
                        string badgeClass = Model.TrangThai switch
                        {
                            "Sẵn sàng" => "bg-success",
                            "Đang thuê" => "bg-warning text-dark",
                            "Bảo trì" => "bg-danger",
                            _ => "bg-secondary"
                        };
                    }
                    <div class="text-center">
                        <span class="badge @badgeClass fs-6">@Model.TrangThai</span>
                    </div>
                </div>

                <!-- Thông tin chi tiết -->
                <div class="col-md-8">
                    <h6 class="fw-bold text-primary mb-3">@Model.TenXe</h6>
                    
                    <div class="row">
                        <div class="col-6">
                            <p><strong>Mã xe:</strong> #XE@(Model.MaXe.ToString("D3"))</p>
                            <p><strong>Biển số:</strong> @Model.BienSoXe</p>
                            <p><strong>Hãng xe:</strong> @Model.HangXe</p>
                            <p><strong>Dòng xe:</strong> @Model.DongXe</p>
                        </div>
                        <div class="col-6">
                            <p><strong>Loại xe:</strong> @Model.LoaiXe?.TenLoaiXe</p>
                            <p><strong>Giá thuê:</strong> <span class="text-danger fw-bold">@Model.GiaThue.ToString("N0")đ/ngày</span></p>
                            <p><strong>Giá trị xe:</strong> @Model.GiaTriXe.ToString("N0")đ</p>
                            <p><strong>Tổng chi phí:</strong> <span class="text-danger fw-bold">@Model.ChiTieu.Sum(c => c.SoTien).ToString("N0")đ</span></p>
                        </div>
                    </div>

                    <!-- Thông tin bổ sung -->
                    @if (Model.NgayGapSuCo.HasValue || !string.IsNullOrEmpty(Model.MoTaThietHai))
                    {
                        <hr />
                        <h6 class="fw-bold text-warning">Thông tin sự cố</h6>
                        @if (Model.NgayGapSuCo.HasValue)
                        {
                            <p><strong>Ngày gặp sự cố:</strong> @Model.NgayGapSuCo.Value.ToString("dd/MM/yyyy")</p>
                        }
                        @if (!string.IsNullOrEmpty(Model.MoTaThietHai))
                        {
                            <p><strong>Mô tả thiệt hại:</strong> @Model.MoTaThietHai</p>
                        }
                        @if (Model.ChiPhiSuaChua > 0)
                        {
                            <p><strong>Chi phí sửa chữa:</strong> <span class="text-danger">@Model.ChiPhiSuaChua.ToString("N0")đ</span></p>
                        }
                    }
                </div>
            </div>
        </div>
        <div class="custom-modal-footer">
            <a href="@Url.Action("LichSuHopDong", "Xe", new { id = Model.MaXe })" class="custom-modal-btn custom-modal-btn-primary">
                <i class="bi bi-clock-history"></i> Xem lịch sử hợp đồng
            </a>
            <a href="@Url.Action("Edit", "Xe", new { id = Model.MaXe })" class="custom-modal-btn custom-modal-btn-warning">
                <i class="bi bi-pencil"></i> Sửa xe
            </a>
            <button type="button" class="custom-modal-btn custom-modal-btn-secondary" onclick="closeCustomModal()">
                <i class="bi bi-x-circle"></i> Đóng
            </button>
        </div>
    </div>
</div> 